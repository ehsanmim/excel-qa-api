# Copy to .env and fill in; the app loads .env at startup. Shell variables take precedence.

# Which LLM plans the queries: "anthropic" (default) or "openai" (any OpenAI-compatible API).
LLM_PROVIDER=openai

# Anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5

# OpenAI-compatible (OpenAI, OpenRouter, Gemini, Ollama, ...)
OPENAI_API_KEY=
OPENAI_MODEL=openai/gpt-6-luna
# Leave empty for OpenAI itself. OpenRouter: https://openrouter.ai/api/v1
OPENAI_BASE_URL=https://openrouter.ai/api/v1
